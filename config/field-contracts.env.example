# Field Contracts activate when all three VEILBOUND_FIELD_* settings are configured.
# Set VEILBOUND_CORE_ID and VEILBOUND_COPPER_ID to the existing testnet contracts.
# Use an existing dedicated operator configured in Core and funded with Core Copper/storage credit.
VEILBOUND_FIELD_OPERATOR_ID=
# Local path to a key with only reserve_field_reward, pay_field_reward and release_field_reward on Core.
VEILBOUND_FIELD_OPERATOR_KEY_PATH=
# JSON array of {id, objective, delivery, rewardAtomic, endsAt}; endsAt is UTC Unix milliseconds.
VEILBOUND_FIELD_OFFERS_PATH=
